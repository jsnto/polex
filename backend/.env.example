# PoleX backend configuration.
# Copy to .env and edit:  cp .env.example .env
# The .env file is gitignored — never commit real credentials.

# --- credentials (required for a real deployment) ---
POLEX_USERNAME=admin
POLEX_PASSWORD=change-me

# --- auth token lifetime (Go duration: 72h, 720h, 30d, ...) ---
POLEX_TOKEN_TTL=720h
# "remember me" logins (sign-in checkbox) get this longer TTL instead:
POLEX_REMEMBER_TTL=720h

# --- optional ---
# ADDR=:8080
# CHECK_INTERVAL=10s
# WOL_BROADCAST=192.168.1.255:9
